# Environment Variables for Evolution Connect

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for server-side operations)
# WARNING: Never expose this in client code, only use on server
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Workers Configuration
WRANGLER_ENV=production
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Admin Configuration (optional)
ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_EMAILS=superadmin@example.com,admin2@example.com

# Feature Flags
ENABLE_ADMIN_PANEL=true
ENABLE_PAYMENT_PROOF_UPLOAD=true
MAINTENANCE_MODE=false

# API Configuration
API_BASE_URL=https://api.yourdomain.com
API_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=5242880 # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Email Configuration (optional)
SENDGRID_API_KEY=your-sendgrid-key
ADMIN_NOTIFICATION_EMAIL=admin-notifications@example.com

# Analytics (optional)
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id
