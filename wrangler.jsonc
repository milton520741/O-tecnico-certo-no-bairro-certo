{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "find-evolve-connect",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production"
  },
  "env": {
    "production": {
      "name": "tecnico-certo-prod",
      "vars": {
        "NODE_ENV": "production"
      }
    },
    "staging": {
      "name": "tecnico-certo-staging",
      "vars": {
        "NODE_ENV": "staging"
      }
    }
  }
}
