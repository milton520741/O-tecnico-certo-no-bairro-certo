{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tecnico-certo",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "production": {
      "name": "tecnico-certo-prod"
    },
    "staging": {
      "name": "tecnico-certo-staging"
    }
  },
  "routes": [
    {
      "pattern": "tecnico-certo.workers.dev/*",
      "zone_name": "workers.dev"
    }
  ]
}
